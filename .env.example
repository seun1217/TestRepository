# Anthropic API key. 서버에서만 사용되며 브라우저로 절대 전달되지 않습니다.
ANTHROPIC_API_KEY=

# 식별 제공자: claude (기본) 또는 mock (개발/테스트용, API 호출 없음)
IDENTIFY_PROVIDER=claude

# 사용할 모델 (기본값 claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# IP당 분당 요청 제한 (/api/identify와 /api/describe 합산). 0이면 제한 없음
RATE_LIMIT_PER_MIN=20

# 리버스 프록시 뒤에서 X-Forwarded-For를 믿을 때 hop 수(예: 1) 또는 "loopback, 10.0.0.0/8" 같은 목록. true는 우회 가능해 1로 취급
# TRUST_PROXY=1

# 서버 포트
PORT=3000
